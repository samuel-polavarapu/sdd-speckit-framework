{
  "version": 2,
  "verifiedOn": "2026-11-13",
  "assistants": {
    "claude": {
      "label": "Claude Code",
      "vscodeExtensions": [
        "anthropic.claude-code"
      ],
      "jetbrainsPlugin": "com.anthropic.code.plugin",
      "jetbrainsMarketplaceUrl": "https://plugins.jetbrains.com/plugin/27310-claude-code-beta-"
    },
    "copilot": {
      "label": "GitHub Copilot",
      "vscodeExtensions": [
        "github.copilot",
        "github.copilot-chat"
      ],
      "jetbrainsPlugin": "com.github.copilot",
      "jetbrainsMarketplaceUrl": "https://plugins.jetbrains.com/plugin/17718-github-copilot"
    }
  },
  "editors": {
    "vscode": {
      "label": "VS Code",
      "default": true,
      "targetDir": ".vscode",
      "copy": [
        {
          "from": "editors/vscode/extensions.json",
          "to": ".vscode/extensions.json",
          "mergeStrategy": "merge-recommendations"
        },
        {
          "from": "editors/vscode/settings.json",
          "to": ".vscode/settings.json",
          "mergeStrategy": "merge-shallow"
        }
      ],
      "mergesPresetExtensions": true,
      "note": "Contributors get a Recommended Extensions prompt on first open. The recommendations are the extensions of every chosen assistant (see `assistants`), plus the stack preset's.",
      "mergesAssistantExtensions": true
    },
    "cursor": {
      "label": "Cursor",
      "default": false,
      "targetDir": ".vscode",
      "copy": [
        {
          "from": "editors/vscode/extensions.json",
          "to": ".vscode/extensions.json",
          "mergeStrategy": "merge-recommendations"
        },
        {
          "from": "editors/vscode/settings.json",
          "to": ".vscode/settings.json",
          "mergeStrategy": "merge-shallow"
        }
      ],
      "mergesPresetExtensions": true,
      "note": "Cursor is a VS Code fork, so it reads .vscode/ and uses the same extension ids.",
      "mergesAssistantExtensions": true
    },
    "jetbrains": {
      "label": "JetBrains IDEs (IntelliJ IDEA, PyCharm, WebStorm, Rider)",
      "default": false,
      "targetDir": ".idea",
      "copy": [
        {
          "from": "editors/jetbrains/externalDependencies.xml",
          "to": ".idea/externalDependencies.xml",
          "mergeStrategy": "render-jetbrains-plugins"
        }
      ],
      "mergesPresetExtensions": false,
      "note": "Lists the plugin of every chosen assistant (see `assistants`). The Claude Code plugin wraps the separately installed Claude Code CLI. Preset extension fragments are VS Code specific and are not applied here."
    },
    "none": {
      "label": "Other, or none",
      "default": false,
      "targetDir": null,
      "copy": [],
      "mergesPresetExtensions": false,
      "note": "Nothing is written. ONBOARDING.md points to the editor docs for each assistant."
    }
  },
  "aliases": {
    "vs-code": "vscode",
    "code": "vscode",
    "intellij": "jetbrains",
    "idea": "jetbrains",
    "pycharm": "jetbrains",
    "webstorm": "jetbrains",
    "rider": "jetbrains",
    "other": "none",
    "skip": "none"
  }
}
