{
  "name": "create-sdd-speckit-app",
  "version": "0.3.0",
  "description": "Interactive installer for the SDD Speckit Framework: scaffolds a spec-driven project wired to Claude Code and/or GitHub Copilot, MCP connectors and your editor.",
  "type": "module",
  "bin": {
    "create-sdd-speckit-app": "bin/cli.js"
  },
  "scripts": {
    "test": "node --test",
    "render:copilot": "node bin/cli.js --emit=copilot ../../adapters/copilot/dist",
    "check:copilot": "node bin/cli.js --emit=copilot --check --strict ../../adapters/copilot/dist"
  },
  "files": [
    "bin",
    "src"
  ],
  "engines": {
    "node": ">=18.0.0"
  },
  "dependencies": {
    "@clack/prompts": "^0.7.0"
  },
  "keywords": [
    "spec-driven-development",
    "speckit",
    "claude-code",
    "scaffold",
    "github-copilot"
  ],
  "license": "MIT"
}
