{
  "$comment": "The one definition of the harness gates. Read by scripts/harness/gate.py, scripts/onboard-project.py and installer/create-sdd-speckit-app/src/config-schema.js. Reference: docs/HARNESS.md.",
  "schema": 1,
  "modes": ["off", "warn", "block"],
  "gates": [
    {
      "id": "constitution-guard",
      "label": "Constitution guard",
      "description": "The constitution changes only through the constitution phase, with a version bump and an amendment row."
    },
    {
      "id": "spec-before-code",
      "label": "Spec before code",
      "description": "A source file changes only when an active feature has spec.md and plan.md."
    },
    {
      "id": "tasks-before-implement",
      "label": "Tasks before implement",
      "description": "A source file changes only when the active feature has tasks.md with at least one task."
    },
    {
      "id": "test-first",
      "label": "Test first",
      "description": "A source change comes with a test change, and the test does not come after the code."
    },
    {
      "id": "secrets-scan",
      "label": "Secrets scan",
      "description": "No credential, private key or profile-defined sensitive value is written to the repository."
    },
    {
      "id": "lint-format",
      "label": "Lint and format",
      "description": "The project's lint and format commands pass."
    }
  ],
  "defaults": {
    "greenfield": {
      "constitution-guard": "block",
      "spec-before-code": "block",
      "tasks-before-implement": "block",
      "test-first": "block",
      "secrets-scan": "block",
      "lint-format": "block"
    },
    "brownfield": {
      "constitution-guard": "block",
      "spec-before-code": "warn",
      "tasks-before-implement": "warn",
      "test-first": "warn",
      "secrets-scan": "block",
      "lint-format": "warn"
    },
    "migrated": {
      "constitution-guard": "block",
      "spec-before-code": "off",
      "tasks-before-implement": "off",
      "test-first": "off",
      "secrets-scan": "off",
      "lint-format": "off"
    }
  },
  "globs": {
    "source": ["src/**", "app/**", "lib/**"],
    "test": ["tests/**", "test/**", "**/*.test.*", "**/*.spec.*", "**/test_*.py", "**/*_test.py", "**/*_test.go", "**/*Tests.cs"],
    "exempt": ["**/*.md", "docs/**", ".github/**", ".specify/**", "specs/**", ".claude/**", ".vscode/**", ".idea/**"]
  },
  "secretPaths": [".env", ".env.*", "**/*.pem", "**/*.p12", "**/*.pfx", "**/id_rsa", "**/id_ed25519", "**/credentials.json", "secrets/**"],
  "secretPathsAllowed": [".env.example", ".env.sample", ".env.template"],
  "secretPatterns": [
    { "id": "private-key", "regex": "-----BEGIN (?:RSA |EC |DSA |OPENSSH |PGP )?PRIVATE KEY-----" },
    { "id": "aws-access-key-id", "regex": "\\b(?:AKIA|ASIA)[0-9A-Z]{16}\\b" },
    { "id": "github-token", "regex": "\\b(?:ghp|gho|ghu|ghs|ghr)_[A-Za-z0-9]{36,}\\b|\\bgithub_pat_[A-Za-z0-9_]{60,}\\b" },
    { "id": "slack-token", "regex": "\\bxox[abprs]-[A-Za-z0-9-]{10,}\\b" },
    { "id": "stripe-live-key", "regex": "\\b[sr]k_live_[A-Za-z0-9]{20,}\\b" },
    { "id": "google-api-key", "regex": "\\bAIza[0-9A-Za-z_-]{35}\\b" },
    { "id": "anthropic-api-key", "regex": "\\bsk-ant-[A-Za-z0-9_-]{20,}\\b" },
    { "id": "jwt", "regex": "\\beyJ[A-Za-z0-9_-]{10,}\\.eyJ[A-Za-z0-9_-]{10,}\\.[A-Za-z0-9_-]{10,}\\b" },
    { "id": "connection-string-password", "regex": "\\b[a-z][a-z0-9+.-]*://[^\\s:/@]+:[^\\s:/@${}<>\\[\\]]{6,}@[^\\s/]+" },
    { "id": "assigned-secret", "regex": "(?i)\\b(?:password|passwd|secret|api[_-]?key|access[_-]?token|client[_-]?secret)\\b[\"']?\\s*[:=]\\s*[\"'][^\"'\\s${}<>\\[\\]]{12,}[\"']" }
  ],
  "permissions": {
    "$comment": "Baseline Claude Code permission rules merged into .claude/settings.json. A stack profile adds its own allow rules. The constitution is not denied here: a deny rule would break the unlock-marker flow.",
    "allow": [
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git branch:*)",
      "Bash(python3 .specify/sdd-speckit/scripts/*)"
    ],
    "ask": [
      "Bash(git push:*)",
      "Edit(.github/workflows/**)",
      "Edit(.specify/sdd-speckit.json)"
    ],
    "deny": [
      "Read(./.env)",
      "Read(./.env.local)",
      "Read(./**/*.pem)",
      "Read(./secrets/**)",
      "Bash(git push --force:*)",
      "Bash(git push -f:*)",
      "Bash(rm -rf /:*)"
    ]
  }
}
