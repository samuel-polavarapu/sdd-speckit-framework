{
  "schema": 1,
  "kind": "stack",
  "id": "web-fullstack-node",
  "label": "Web full-stack (Node + TypeScript)",
  "description": "TypeScript end to end: React front end, Node API, Postgres, Vitest and Playwright.",
  "speckit": {
    "presetHint": "Run `specify preset search` for a published preset that matches this stack before relying on these local overrides."
  },
  "defaults": {
    "language": "TypeScript 5.6",
    "runtime": "Node 22 LTS",
    "frontend": "React 19 + Vite",
    "backend": "Fastify",
    "storage": "PostgreSQL 17 + Prisma",
    "unitTest": "Vitest",
    "e2eTest": "Playwright",
    "lint": "ESLint + Prettier",
    "packageManager": "pnpm"
  },
  "recommendedMcp": [
    "github",
    "playwright",
    "figma"
  ],
  "harness": {
    "sourceGlobs": [
      "src/**",
      "apps/**",
      "packages/**"
    ],
    "testGlobs": [
      "**/*.test.ts",
      "**/*.test.tsx",
      "**/*.spec.ts",
      "e2e/**",
      "tests/**"
    ],
    "commands": {
      "test": "npm test",
      "lint": "npx eslint .",
      "format": "npx prettier --check .",
      "lintFile": "npx eslint {file}"
    }
  },
  "permissions": {
    "allow": [
      "Bash(npm test:*)",
      "Bash(npm run:*)",
      "Bash(npx eslint:*)",
      "Bash(npx prettier:*)",
      "Bash(npx tsc:*)",
      "Bash(npx vitest:*)",
      "Bash(npx playwright test:*)",
      "Bash(npx prisma generate:*)"
    ]
  }
}
