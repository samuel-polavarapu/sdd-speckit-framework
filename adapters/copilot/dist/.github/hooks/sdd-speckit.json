{
  "version": 1,
  "hooks": {
    "preToolUse": [
      {
        "type": "command",
        "bash": "sh .specify/sdd-speckit/scripts/hooks/guard-constitution.sh",
        "cwd": ".",
        "timeoutSec": 10
      }
    ],
    "postToolUse": [
      {
        "type": "command",
        "bash": "sh .specify/sdd-speckit/scripts/hooks/log-artifact-change.sh",
        "cwd": ".",
        "timeoutSec": 10
      }
    ]
  }
}
