{
  "version": 1,
  "hooks": {
    "preToolUse": [
      {
        "type": "command",
        "bash": "sh .specify/sdd-speckit/scripts/harness/hook.sh pre",
        "cwd": ".",
        "timeoutSec": 15
      }
    ],
    "postToolUse": [
      {
        "type": "command",
        "bash": "sh .specify/sdd-speckit/scripts/hooks/log-artifact-change.sh",
        "cwd": ".",
        "timeoutSec": 10
      },
      {
        "type": "command",
        "bash": "sh .specify/sdd-speckit/scripts/harness/hook.sh post",
        "cwd": ".",
        "timeoutSec": 30
      }
    ]
  }
}
